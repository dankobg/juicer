juicer-dev.xyz {
        tls internal

        # auth (ory kratos)
        handle_path /kratos/* {
                reverse_proxy juicer-kratos:4433
        }

        # backend api (go)
        @backend path /api/* /ws* /webhooks/* /public/* /uploads/* /spec* /docs/*
        handle @backend {
                reverse_proxy host.docker.internal:1337
        }

        # web frontend (sveltekit)
        handle {
                reverse_proxy {env.VITE_PUBLIC_VITE_NETWORK}:3000
        }
}

mail.juicer-dev.xyz {
        tls internal

        # test mailserver (mailpit)
        reverse_proxy juicer-mailpit:8025
}

